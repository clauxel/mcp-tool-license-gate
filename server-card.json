{
  "name": "mcptoollicense",
  "title": "MCP Tool License Gate",
  "description": "A paid remote MCP gate that evaluates tool name, vendor URL, license text, intended use, customer policy, and data class before execution.",
  "version": "1.0.0",
  "websiteUrl": "https://mcptoollicense.clauxel.com/",
  "documentationUrl": "https://mcptoollicense.clauxel.com/mcp/",
  "endpointUrl": "https://mcptoollicense.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://mcptoollicense.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://mcptoollicense.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://mcptoollicense.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "starter",
        "name": "Starter",
        "monthlyUsd": 39
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 129
      },
      {
        "id": "scale",
        "name": "Scale",
        "monthlyUsd": 349
      }
    ]
  },
  "tools": [
    {
      "name": "check_tool_license",
      "description": "MCP Tool License Gate check tool license",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "string",
            "description": "Workflow sample, schema, policy fixture, or agent output."
          },
          "context": {
            "type": "string",
            "description": "Optional review context."
          }
        },
        "required": [
          "sample"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          },
          "usage_units": {
            "type": "integer"
          },
          "next_action": {
            "type": "string"
          }
